* Public: CTLE single-ended input impedance and return loss at tt, 3.3 V, 27 C, gain=00, peak=00, by a 1 A AC
* current into vinp with vinn terminated in 50 ohm to the vocm pin. Set excite_p=0 and excite_n=1 to measure vinn.
.lib "/opt/ihp/pdk/ihp-sg13g2/libs.tech/ngspice/models/cornerMOSlv.lib" mos_tt
.lib "/opt/ihp/pdk/ihp-sg13g2/libs.tech/ngspice/models/cornerMOShv.lib" mos_tt
.lib "/opt/ihp/pdk/ihp-sg13g2/libs.tech/ngspice/models/cornerHBT.lib" hbt_typ
.lib "/opt/ihp/pdk/ihp-sg13g2/libs.tech/ngspice/models/cornerRES.lib" res_typ
.lib "/opt/ihp/pdk/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib" cap_typ
.include "/app/circuit.spi"
.options filetype=ascii reltol=2e-4 abstol=1e-12 vntol=1e-6
.param supply=3.3
.param temperature=27
.temp {temperature}
.param code_g0=0
.param code_g1=0
.param code_p0=0
.param code_p1=0
.param excite_p=1
.param excite_n=0
VSS vss 0 0
VDD vdd vss {supply}
IREF vdd iref 100u
VOCM vcmsrc vss {supply/2}
RVOCM vcmsrc vocm 10
RDCP vinp vocm 1G
RDCN vinn vocm 1G
RREFP vinp vocm {50+excite_p*1e12}
RREFN vinn vocm {50+excite_n*1e12}
ITP 0 vinp AC {excite_p}
ITN 0 vinn AC {excite_n}
VGB0 sgb0 vss {code_g0*supply}
RGB0 sgb0 gain_b0 1k
VGB1 sgb1 vss {code_g1*supply}
RGB1 sgb1 gain_b1 1k
VPB0 spb0 vss {code_p0*supply}
RPB0 spb0 peak_b0 1k
VPB1 spb1 vss {code_p1*supply}
RPB1 spb1 peak_b1 1k
XDUT vss vdd iref vocm vinp vinn gain_b0 gain_b1 peak_b0 peak_b1 voutp voutn ctle_28g
CLP voutp vss 200f
CLN voutn vss 200f

.control
ac dec 20 100 40g
let zinp_ohm = mag(v(vinp)-v(vocm))
let zinn_ohm = mag(v(vinn)-v(vocm))
let s11p_db = 20*log10(mag((v(vinp)-v(vocm)-50)/(v(vinp)-v(vocm)+50)))
let s11n_db = 20*log10(mag((v(vinn)-v(vocm)-50)/(v(vinn)-v(vocm)+50)))
meas ac zinp_1m find zinp_ohm at=1meg
meas ac zinn_1m find zinn_ohm at=1meg
meas ac s11p_max_db max s11p_db from=100meg to=14g
meas ac s11n_max_db max s11n_db from=100meg to=14g
echo CTLE_ANALYSES_COMPLETE
.endc
.end
