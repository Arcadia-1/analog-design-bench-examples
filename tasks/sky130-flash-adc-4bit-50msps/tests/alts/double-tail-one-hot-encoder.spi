* Alternative structure: double-tail comparators, NOR SR latches and a one-hot
* ROM-style encoder, on a 200 ohm-segment sampled ladder front end.

.subckt dt_inv a y vdd vss
XP y a vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=4 nf=1
XN y a vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1
.ends dt_inv

.subckt dt_nand2 a b y vdd vss
XP1 y a vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1
XP2 y b vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1
XN1 y a nx vss sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1
XN2 nx b vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1
.ends dt_nand2

.subckt dt_nand4 a b c d y vdd vss
XP1 y a vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1
XP2 y b vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1
XP3 y c vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1
XP4 y d vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1
XN1 y a n1 vss sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1
XN2 n1 b n2 vss sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1
XN3 n2 c n3 vss sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1
XN4 n3 d vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1
.ends dt_nand4

.subckt dt_nor2 a b y vdd vss
XP1 m a vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=4 nf=1
XP2 y b m vdd sky130_fd_pr__pfet_01v8 l=0.15 w=4 nf=1
XN1 y a vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1
XN2 y b vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1
.ends dt_nor2

.subckt dt_tg a b en enb vdd vss
XN a en b vss sky130_fd_pr__nfet_01v8 l=0.15 w=128 nf=32
XP a enb b vdd sky130_fd_pr__pfet_01v8 l=0.15 w=256 nf=64
.ends dt_tg

.subckt dt_comp clk clkb inp inn outp outn vdd vss
XT1 t1 clk vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=2
XIP di_p inp t1 vss sky130_fd_pr__nfet_01v8 l=0.18 w=16 nf=4
XIN di_n inn t1 vss sky130_fd_pr__nfet_01v8 l=0.18 w=16 nf=4
XRP di_p clk vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1
XRN di_n clk vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1
XT2 t2 clkb vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=8 nf=2
XLP1 outp outn t2 vdd sky130_fd_pr__pfet_01v8 l=0.15 w=4 nf=1
XLP2 outn outp t2 vdd sky130_fd_pr__pfet_01v8 l=0.15 w=4 nf=1
XLN1 outp outn vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1
XLN2 outn outp vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1
XCP outp di_p vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1
XCN outn di_n vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1
.ends dt_comp

.subckt dt_sr s r q qb vdd vss
XG1 r qb q vdd vss dt_nor2
XG2 s q qb vdd vss dt_nor2
.ends dt_sr

