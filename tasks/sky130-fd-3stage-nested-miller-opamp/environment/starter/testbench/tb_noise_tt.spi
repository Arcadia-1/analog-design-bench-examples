* Noise in the capacitive gain -1 network (1 pF input and feedback
* capacitors, differential-only DC servo through 1 TH) at tt / 1.8 V / 27 C:
* noise of Vod referred to one input source.  Prints the input-referred
* density at 100 kHz and its minimum from 10 kHz to 1 MHz (grading caps the
* upper end of that window at a tenth of the unity-gain frequency).
* Run with `ngspice -b testbench/tb_noise_tt.spi`.
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "/app/circuit.spi"
.options reltol=1e-5 abstol=1e-15 vntol=1e-9
.temp 27
VDD vdd 0 1.8
VSS vss 0 0
IBIAS vdd ibias 10u
VCM vcm 0 0.9
VIP vip vcm DC 0 AC 1
VIN vin vcm 0
C1 vip inp 1p
C2 inp outn 1p
C3 vin inn 1p
C4 inn outp 1p
EP sp vcm outn outp 0.5
EN sn vcm outp outn 0.5
LP sp inp 1T
LN sn inn 1T
XDUT vss ibias vdd vcmpin inp inn outp outn fd3_nmc_opamp
RVCM vcm vcmpin 1k
RLP outp vcm 1meg
CLP outp 0 2p
RLN outn vcm 1meg
CLN outn 0 2p
.control
set noaskquit
noise v(outp,outn) vip dec 20 10k 1Meg
setplot noise1
let en_white_v_rthz = vecmin(inoise_spectrum)
print en_white_v_rthz
noise v(outp,outn) vip lin 1 100k 100k
setplot noise3
let en_100khz_v_rthz = inoise_spectrum
print en_100khz_v_rthz
quit
.endc
.end
