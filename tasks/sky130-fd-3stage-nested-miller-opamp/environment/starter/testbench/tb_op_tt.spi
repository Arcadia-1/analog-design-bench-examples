* Inverting gain -1 application (100 kohm networks) at tt / 1.8 V / 27 C
* with zero input and 2 pF || 1 Mohm on each output: output offset Vod,
* output common mode, supply current and the current drawn from vcm (fed
* through 1 kohm).  Feedback runs from voutn to vinp
* and from voutp to vinn.  Run with `ngspice -b testbench/tb_op_tt.spi`;
* every metric is printed as `name = value`.
* Then repeats the operating point at 8 and 12 uA of bias current: icc_tracking is the
* exponent n of Icc ~ Ibias^n, the scored bias-tracking quantity.
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "/app/circuit.spi"
.options reltol=1e-6 abstol=1e-15 vntol=1e-9
.temp 27
VDD vdd 0 1.8
VSS vss 0 0
IBIAS vdd ibias 10u
VCM vcm 0 0.9
R1 vcm inp 100k
R2 inp outn 100k
R3 vcm inn 100k
R4 inn outp 100k
XDUT vss ibias vdd vcmpin inp inn outp outn fd3_nmc_opamp
RVCM vcm vcmpin 1k
RLP outp vcm 1meg
CLP outp 0 2p
RLN outn vcm 1meg
CLN outn 0 2p
.control
set noaskquit
op
let vod_v = v(outp) - v(outn)
let vocm_v = 0.5 * (v(outp) + v(outn))
let icc_a = -i(vdd)
let vos_in_v = vod_v / 2
let vcm_pin_current_a = abs(v(vcm) - v(vcmpin)) / 1k
print vod_v vos_in_v vocm_v icc_a vcm_pin_current_a
alter ibias dc = 8u
op
let icc_low_bias_a = -i(vdd)
alter ibias dc = 12u
op
let icc_high_bias_a = -i(vdd)
let icc_tracking = ln(icc_high_bias_a / op2.icc_low_bias_a) / ln(1.5)
print icc_tracking
quit
.endc
.end
