* Public development bench: tt, 1.80 V, 27 C, LO 0.35 V, 50 uA. Grading uses the same circuit and metric
* definitions at other corners, supplies, temperatures, LO amplitudes and reference currents.
* Gilbert mixer, linearity: two-tone IIP3 at two drive levels and gain compression against a
* small-signal baseline. Four copies of the mixer, each with its own supply, reference and sources.
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "/app/circuit.spi"
.options method=trap reltol=1e-3 abstol=1e-12 vntol=1e-6
.param supply=1.8
.param temperature=27
.param iref=50u
.param lo_amp=0.35
.temp {temperature}
* Two tones at 2.40 and 2.45 GHz, 10 mV peak per tone per side.
VDDl vddl 0 {supply}
IREFl vddl irefl {iref}
RIREFl vddl irefl 1Meg
VLOPl lospl 0 SIN(0.9 {lo_amp} 2.2Gig 0 0 0)
VLONl losnl 0 SIN(0.9 {lo_amp} 2.2Gig 0 0 180)
RLOPl lospl lopl 50
RLONl losnl lonl 50
VRFPl rf1pl 0 SIN(0.9 10m 2.4Gig 0 0 0)
VRFP2l rfspl rf1pl SIN(0 10m 2.45Gig 0 0 0)
VRFNl rf1nl 0 SIN(0.9 10m 2.4Gig 0 0 180)
VRFN2l rfsnl rf1nl SIN(0 10m 2.45Gig 0 0 180)
RRFPl rfspl rfpl 50
RRFNl rfsnl rfnl 50
Xl 0 irefl vddl lopl lonl rfpl rfnl ifpl ifnl gilbert_mixer
CIFPl ifpl 0 200f
CIFNl ifnl 0 200f
* Two tones at 2.40 and 2.45 GHz, 20 mV peak per tone per side.
VDDh vddh 0 {supply}
IREFh vddh irefh {iref}
RIREFh vddh irefh 1Meg
VLOPh losph 0 SIN(0.9 {lo_amp} 2.2Gig 0 0 0)
VLONh losnh 0 SIN(0.9 {lo_amp} 2.2Gig 0 0 180)
RLOPh losph loph 50
RLONh losnh lonh 50
VRFPh rf1ph 0 SIN(0.9 20m 2.4Gig 0 0 0)
VRFP2h rfsph rf1ph SIN(0 20m 2.45Gig 0 0 0)
VRFNh rf1nh 0 SIN(0.9 20m 2.4Gig 0 0 180)
VRFN2h rfsnh rf1nh SIN(0 20m 2.45Gig 0 0 180)
RRFPh rfsph rfph 50
RRFNh rfsnh rfnh 50
Xh 0 irefh vddh loph lonh rfph rfnh ifph ifnh gilbert_mixer
CIFPh ifph 0 200f
CIFNh ifnh 0 200f
* One 2.4 GHz tone, 80 mV peak per side (compression).
VDDg vddg 0 {supply}
IREFg vddg irefg {iref}
RIREFg vddg irefg 1Meg
VLOPg lospg 0 SIN(0.9 {lo_amp} 2.2Gig 0 0 0)
VLONg losng 0 SIN(0.9 {lo_amp} 2.2Gig 0 0 180)
RLOPg lospg lopg 50
RLONg losng long 50
VRFPg rfspg 0 SIN(0.9 80m 2.4Gig 0 0 0)
VRFNg rfsng 0 SIN(0.9 80m 2.4Gig 0 0 180)
RRFPg rfspg rfpg 50
RRFNg rfsng rfng 50
Xg 0 irefg vddg lopg long rfpg rfng ifpg ifng gilbert_mixer
CIFPg ifpg 0 200f
CIFNg ifng 0 200f
* One 2.4 GHz tone, 20 mV peak per side (compression baseline).
VDDs vdds 0 {supply}
IREFs vdds irefs {iref}
RIREFs vdds irefs 1Meg
VLOPs losps 0 SIN(0.9 {lo_amp} 2.2Gig 0 0 0)
VLONs losns 0 SIN(0.9 {lo_amp} 2.2Gig 0 0 180)
RLOPs losps lops 50
RLONs losns lons 50
VRFPs rfsps 0 SIN(0.9 20m 2.4Gig 0 0 0)
VRFNs rfsns 0 SIN(0.9 20m 2.4Gig 0 0 180)
RRFPs rfsps rfps 50
RRFNs rfsns rfns 50
Xs 0 irefs vdds lops lons rfps rfns ifps ifns gilbert_mixer
CIFPs ifps 0 200f
CIFNs ifns 0 200f
.control
set noaskquit
* 10 ns settling, then a 20 ns window: 1024 samples of 19.53125 ps, so every tone (2.2, 2.4, 2.45 GHz
* and their 50 MHz-grid products) falls exactly on an FFT bin.
tran 19.53125p 29.98046875n 10n 19.53125p
linearize v(ifpl) v(ifnl) v(ifph) v(ifnh) v(ifpg) v(ifng) v(ifps) v(ifns) v(rfpl) v(rfnl) v(rfph) v(rfnh) v(rfpg) v(rfng) v(rfps) v(rfns)
let low_out = v(ifpl)-v(ifnl)
let high_out = v(ifph)-v(ifnh)
let large_out = v(ifpg)-v(ifng)
let small_out = v(ifps)-v(ifns)
let low_in = v(rfpl)-v(rfnl)
let high_in = v(rfph)-v(rfnh)
let large_in = v(rfpg)-v(rfng)
let small_in = v(rfps)-v(rfns)
set specwindow=none
fft low_out high_out large_out small_out low_in high_in large_in small_in
let low_out_mag = mag(low_out)
let high_out_mag = mag(high_out)
let large_out_mag = mag(large_out)
let small_out_mag = mag(small_out)
let low_in_mag = mag(low_in)
let high_in_mag = mag(high_in)
let large_in_mag = mag(large_in)
let small_in_mag = mag(small_in)
meas sp low_fund1_v FIND low_out_mag AT=200Meg
meas sp low_fund2_v FIND low_out_mag AT=250Meg
meas sp low_im3_lower_v FIND low_out_mag AT=150Meg
meas sp low_im3_upper_v FIND low_out_mag AT=300Meg
meas sp low_in1_v FIND low_in_mag AT=2.4Gig
meas sp low_in2_v FIND low_in_mag AT=2.45Gig
meas sp high_fund1_v FIND high_out_mag AT=200Meg
meas sp high_fund2_v FIND high_out_mag AT=250Meg
meas sp high_im3_lower_v FIND high_out_mag AT=150Meg
meas sp high_im3_upper_v FIND high_out_mag AT=300Meg
meas sp high_in1_v FIND high_in_mag AT=2.4Gig
meas sp high_in2_v FIND high_in_mag AT=2.45Gig
meas sp large_out_v FIND large_out_mag AT=200Meg
meas sp large_in_v FIND large_in_mag AT=2.4Gig
meas sp small_out_v FIND small_out_mag AT=200Meg
meas sp small_in_v FIND small_in_mag AT=2.4Gig
* Each drive level: mean of the two tones, the larger IM3 product, the mean input tone (differential peak
* volts at the pins). IIP3 = drive + (fundamental/IM3 in dB)/2, as available power from the 100 ohm
* differential source: + 10*log10(1/(2*100 ohm*1 mW)).
let low_fund = (low_fund1_v+low_fund2_v)/2
let high_fund = (high_fund1_v+high_fund2_v)/2
let low_im3 = max(low_im3_lower_v,low_im3_upper_v)
let high_im3 = max(high_im3_lower_v,high_im3_upper_v)
let low_in = (low_in1_v+low_in2_v)/2
let high_in = (high_in1_v+high_in2_v)/2
let dbm_per_v = db(1/sqrt(2*100*1e-3))
let low_iip3_dbm = db(low_in)+db(low_fund/low_im3)/2+dbm_per_v
let high_iip3_dbm = db(high_in)+db(high_fund/high_im3)/2+dbm_per_v
let drive_step_db = db(high_in/low_in)
let fundamental_slope = db(high_fund/low_fund)/drive_step_db
let im3_slope = db(high_im3/low_im3)/drive_step_db
let tone_gain_difference_db = max(abs(db(low_fund1_v/low_fund2_v)),abs(db(high_fund1_v/high_fund2_v)))
let compression_db = db(small_out_v/small_in_v)-db(large_out_v/large_in_v)
print low_iip3_dbm high_iip3_dbm fundamental_slope im3_slope tone_gain_difference_db compression_db
quit
.endc
.end
