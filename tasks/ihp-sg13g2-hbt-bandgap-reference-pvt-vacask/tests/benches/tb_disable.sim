Bandgap disable bench (hidden): power up with enable high, settle, then pull the enable source to 0 V
include "sg13g2_vacask_common.lib"
include "cornerMOShv.lib" section=__MOS__
include "cornerMOSlv.lib" section=__MOS__
include "cornerHBT.lib" section=__HBT__
include "cornerRES.lib" section=__RES__
include "cornerCAP.lib" section=__CAP__
include "circuit.sim"
model vsource vsource
model isource isource

vdd (vdd 0) vsource dc=__VDD__
vensrc (ensrc 0) vsource dc=__VDD__
ren (ensrc en) sg13g2_default_mod_r r=10k
xdut (vdd 0 en vref) bandgap
cl (vref 0) sg13g2_default_mod_c c=__CL__

control
  options temp=__TEMP__
  // supply and enable rise together in 1 us from 1 us; the enable source falls to 0 V in 100 ns from 20 us
  alter instance("vdd") type="pulse" val0=0 val1=__VDD__ rise=1u delay=1u
  alter instance("vensrc") type="pulse" val0=0 val1=__VDD__ rise=1u delay=1u width=18u fall=100n
  analysis dis tran stop=40.1u step=10n maxstep=50n icmode="op"
endc
