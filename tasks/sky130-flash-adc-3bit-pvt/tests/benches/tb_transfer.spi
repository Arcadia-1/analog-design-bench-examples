* Hidden full-rate transfer bench: code centers and inputs 0.3 LSB either side of every threshold.
* Each threshold is approached from a distant code; the order differs from the public bench.
* expected codes (conversions 0..32, first 2 are warm-up): 0 7 3 4 3 0 4 7 0 2 1 6 6 1 7 5 2 0 3 7 5 2 6 4 1 7 2 1 4 7 0 5 3
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "/app/circuit.spi"
.options method=gear reltol=1e-3 abstol=1e-12 vntol=1e-6 chgtol=1e-15
.temp 27
VSS vss 0 0
VSUP vdd vss 1.8
VRP vrefp_s vss 1.4
RRP vrefp_s vrefp 10
VRN vrefn_s vss 0.6
RRN vrefn_s vrefn 10
VCK clk_s vss PULSE(0 1.8 10n 0.3n 0.3n 9.4n 20n)
RCK clk_s clk 50
VSIG vin vss PWL(0 0.65
+ 20n 0.65 20.2n 1.35
+ 40n 1.35 40.2n 0.95
+ 60n 0.95 60.2n 1.05
+ 80n 1.05 80.2n 0.97
+ 100n 0.97 100.2n 0.65
+ 120n 0.65 120.2n 1.03
+ 140n 1.03 140.2n 1.35
+ 160n 1.35 160.2n 0.67
+ 180n 0.67 180.2n 0.85
+ 200n 0.85 200.2n 0.73
+ 220n 0.73 220.2n 1.25
+ 240n 1.25 240.2n 1.27
+ 260n 1.27 260.2n 0.75
+ 280n 0.75 280.2n 1.33
+ 300n 1.33 300.2n 1.15
+ 320n 1.15 320.2n 0.87
+ 340n 0.87 340.2n 0.65
+ 360n 0.65 360.2n 0.93
+ 380n 0.93 380.2n 1.35
+ 400n 1.35 400.2n 1.17
+ 420n 1.17 420.2n 0.85
+ 440n 0.85 440.2n 1.23
+ 460n 1.23 460.2n 1.05
+ 480n 1.05 480.2n 0.77
+ 500n 0.77 500.2n 1.35
+ 520n 1.35 520.2n 0.83
+ 540n 0.83 540.2n 0.75
+ 560n 0.75 560.2n 1.07
+ 580n 1.07 580.2n 1.35
+ 600n 1.35 600.2n 0.65
+ 620n 0.65 620.2n 1.13
+ 640n 1.13 640.2n 0.95)
XADC vss vdd vrefn vrefp clk vin b2 b1 b0 flash_adc_3bit
CB2 b2 vss 15f
CB1 b1 vss 15f
CB0 b0 vss 15f

.control
set noaskquit
tran 50p 671n
* net power into the circuit through every pin: vdd, vrefp, vrefn, clk and vin
let p_vdd = -v(vdd)*i(vsup)
let p_vrefp = -v(vrefp)*i(vrp)
let p_vrefn = -v(vrefn)*i(vrn)
let p_clk = -v(clk)*i(vck)
let p_vin = -v(vin)*i(vsig)
let p_total = p_vdd+p_vrefp+p_vrefn+p_clk+p_vin
meas tran power avg p_total from=50n to=670n
meas tran power_vdd avg p_vdd from=50n to=670n
meas tran power_vrefp avg p_vrefp from=50n to=670n
meas tran power_vrefn avg p_vrefn from=50n to=670n
meas tran power_clk avg p_clk from=50n to=670n
meas tran power_vin avg p_vin from=50n to=670n
* conversion k: rising clk edge at 10n+k*20n; code read 19 ns later; levels held from 9.5 ns to 19 ns
let k = 2
while k < 33
  let t_read = 10n+k*20n+19n
  let t_hold = 10n+k*20n+9.5n
  set kk = $&k
  meas tran s{$kk}_b2 find v(b2) at=$&t_read
  meas tran s{$kk}_b1 find v(b1) at=$&t_read
  meas tran s{$kk}_b0 find v(b0) at=$&t_read
  meas tran s{$kk}_b2_min min v(b2) from=$&t_hold to=$&t_read
  meas tran s{$kk}_b2_max max v(b2) from=$&t_hold to=$&t_read
  meas tran s{$kk}_b1_min min v(b1) from=$&t_hold to=$&t_read
  meas tran s{$kk}_b1_max max v(b1) from=$&t_hold to=$&t_read
  meas tran s{$kk}_b0_min min v(b0) from=$&t_hold to=$&t_read
  meas tran s{$kk}_b0_max max v(b0) from=$&t_hold to=$&t_read
  let k = k+1
end
quit
.endc
.end
