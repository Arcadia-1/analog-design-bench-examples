* Public 16-sample coherent sine: bin 1 of 16 (3.125 MHz), 0.36 V amplitude around 1.0 V, tt / 1.80 V / 27 C.
* Grading uses another amplitude and phase. Every ideal sample lies at least 0.14 LSB from a threshold for any
* sampling instant from the start of the clock source's rising edge to 1.5 ns after it.
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "/app/circuit.spi"
.options method=gear reltol=1e-3 abstol=1e-12 vntol=1e-6 chgtol=1e-15
.temp 27
VSS vss 0 0
VSUP vdd vss 1.8
VRP vrefp_s vss 1.4
RRP vrefp_s vrefp 10
VRN vrefn_s vss 0.6
RRN vrefn_s vrefn 10
VCK clk_s vss PULSE(0 1.8 10n 0.3n 0.3n 9.4n 20n)
RCK clk_s clk 50
VSIG vin vss SIN(1.0 0.36 3.125Meg 0 0 351)
XADC vss vdd vrefn vrefp clk vin b2 b1 b0 flash_adc_3bit
CB2 b2 vss 15f
CB1 b1 vss 15f
CB0 b0 vss 15f

.control
set noaskquit
tran 50p 371n
* net power into the circuit through every pin: vdd, vrefp, vrefn, clk and vin
let p_vdd = -v(vdd)*i(vsup)
let p_vrefp = -v(vrefp)*i(vrp)
let p_vrefn = -v(vrefn)*i(vrn)
let p_clk = -v(clk)*i(vck)
let p_vin = -v(vin)*i(vsig)
let p_total = p_vdd+p_vrefp+p_vrefn+p_clk+p_vin
meas tran power avg p_total from=50n to=370n
meas tran power_vdd avg p_vdd from=50n to=370n
meas tran power_vrefp avg p_vrefp from=50n to=370n
meas tran power_vrefn avg p_vrefn from=50n to=370n
meas tran power_clk avg p_clk from=50n to=370n
meas tran power_vin avg p_vin from=50n to=370n
* conversion k: rising clk edge at 10n+k*20n; code read 19 ns later; levels held from 3 ns to 19 ns
let k = 2
while k < 18
  let t_read = 10n+k*20n+19n
  let t_hold = 10n+k*20n+3n
  set kk = $&k
  meas tran s{$kk}_b2 find v(b2) at=$&t_read
  meas tran s{$kk}_b1 find v(b1) at=$&t_read
  meas tran s{$kk}_b0 find v(b0) at=$&t_read
  meas tran s{$kk}_b2_min min v(b2) from=$&t_hold to=$&t_read
  meas tran s{$kk}_b2_max max v(b2) from=$&t_hold to=$&t_read
  meas tran s{$kk}_b1_min min v(b1) from=$&t_hold to=$&t_read
  meas tran s{$kk}_b1_max max v(b1) from=$&t_hold to=$&t_read
  meas tran s{$kk}_b0_min min v(b0) from=$&t_hold to=$&t_read
  meas tran s{$kk}_b0_max max v(b0) from=$&t_hold to=$&t_read
  let k = k+1
end
quit
.endc
.end
