* Public nominal closed-loop bandwidth and input loading (tt, 1.8 V, 27 C).
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "../circuit.spi"
.options reltol=2e-4 abstol=1e-12 vntol=1e-6
.param supply=1.8
.param temperature=27
.temp {temperature}
VSS vss 0 0
VDD vdd vss {supply}
IBIAS vdd ibias 50u
VIN vin vss {supply/2} AC 1
XBUF vss ibias vdd vin vout unity_gain_buffer
CL vout vss 1p

.control
set noaskquit
ac dec 100 1k 10Gig
let transfer = v(vout)/v(vin)
let transfer_db = db(transfer)
let transfer_mag = mag(transfer)
meas ac gain_1k_vv FIND transfer_mag AT=1k
meas ac gain_1k_db FIND transfer_db AT=1k
let bandwidth_threshold_db = gain_1k_db - 3
meas ac bandwidth_crossing_hz WHEN transfer_db=bandwidth_threshold_db FALL=1
let input_admittance_mag = mag(i(VIN)/v(vin))
meas ac input_admittance_100meg_s FIND input_admittance_mag AT=100Meg
let buffer_gain_vv = gain_1k_vv
let buffer_bandwidth_hz = bandwidth_crossing_hz
let input_capacitance_f = input_admittance_100meg_s/(2*3.141592653589793*100e6)
echo UGB_RESULTS_BEGIN
print buffer_gain_vv buffer_bandwidth_hz input_capacitance_f
echo UGB_RESULTS_END
quit
.endc
.end
