* Public nominal DC tracking sweep (tt, 1.8 V, 27 C).
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "../circuit.spi"
.options reltol=2e-4 abstol=1e-12 vntol=1e-6
.param supply=1.8
.param temperature=27
.temp {temperature}
VSS vss 0 0
VDD vdd vss {supply}
IBIAS vdd ibias 50u
VSWEEP sweep 0 0
BINPUT vin vss V={0.45*supply+V(sweep)*0.10*supply}
XBUF vss ibias vdd vin vout unity_gain_buffer
CL vout vss 1p

.control
set noaskquit
dc VSWEEP 0 1 0.008333333333
let tracking_error = abs(v(vout)-v(vin))
meas dc tracking_error_max_v MAX tracking_error
let tracking_error_v = tracking_error_max_v
echo UGB_RESULTS_BEGIN
print tracking_error_v
echo UGB_RESULTS_END
quit
.endc
.end
