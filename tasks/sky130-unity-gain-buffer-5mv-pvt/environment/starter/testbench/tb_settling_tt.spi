* Public nominal bidirectional 100 mV settling and quiescent DUT power (tt, 1.8 V, 27 C).
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "../circuit.spi"
.options method=gear reltol=2e-4 abstol=1e-12 vntol=1e-6 chgtol=1e-15 itl4=200 gmin=1e-10
.param supply=1.8
.param temperature=27
.temp {temperature}
VSS vss 0 0
VDD vdd vss {supply}
IBIAS vdd ibias 50u
VIN vin vss PWL(0 {supply/2} 19.9n {supply/2} 20n {supply/2+0.1} 79.9n {supply/2+0.1} 80n {supply/2} 139.9n {supply/2} 140n {supply/2-0.1} 220n {supply/2-0.1})
XBUF vss ibias vdd vin vout unity_gain_buffer
CL vout vss 1p

.control
set noaskquit
tran 10p 220n
meas tran quiescent_vdd_current_a AVG i(VDD) FROM=10n TO=19n
meas tran supply_v FIND v(vdd) AT=15n
let quiescent_dut_power_w = max(0,(-quiescent_vdd_current_a-50u)*supply_v)

* Commanded targets come from the input source, never from the output tail.
meas tran rise_target_v FIND v(vin) AT=60n
let rise_error = abs(v(vout)-rise_target_v)
* Latest simulator time point in the window that is still outside the band.
let rise_outside_time = time*(rise_error gt 5m)*(time ge 20n)*(time le 79.9n)
meas tran rise_last_outside_s MAX rise_outside_time FROM=20n TO=79.9n
let settling_rise_time_s = max(0,rise_last_outside_s-20n)
meas tran rise_final_v AVG v(vout) FROM=70n TO=79n
meas tran rise_peak_v MAX v(vout) FROM=20n TO=79.9n
let settling_rise_final_tracking_error_v = abs(rise_final_v-rise_target_v)
let settling_overshoot_v = max(0,rise_peak_v-rise_target_v)

meas tran fall_target_v FIND v(vin) AT=180n
let fall_error = abs(v(vout)-fall_target_v)
let fall_outside_time = time*(fall_error gt 5m)*(time ge 140n)*(time le 220n)
meas tran fall_last_outside_s MAX fall_outside_time FROM=140n TO=220n
let settling_fall_time_s = max(0,fall_last_outside_s-140n)
meas tran fall_final_v AVG v(vout) FROM=210n TO=220n
meas tran fall_trough_v MIN v(vout) FROM=140n TO=220n
let settling_fall_final_tracking_error_v = abs(fall_final_v-fall_target_v)
let settling_undershoot_v = max(0,fall_target_v-fall_trough_v)

echo UGB_RESULTS_BEGIN
print quiescent_dut_power_w settling_rise_time_s settling_fall_time_s
print settling_rise_final_tracking_error_v settling_fall_final_tracking_error_v
print settling_overshoot_v settling_undershoot_v
echo UGB_RESULTS_END
quit
.endc
.end
