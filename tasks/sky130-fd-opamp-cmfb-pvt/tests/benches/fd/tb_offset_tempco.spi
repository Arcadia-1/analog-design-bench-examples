* FD-02  Offset and output common-mode temperature drift
* Spec 3.2.1.2 applied to the FD-01 network: DC sweep of temperature
* {{TEMP_START}} .. {{TEMP_STOP}} C in 1 C steps.
{{SEED_OPTION}}
.lib "{{MODEL_LIB}}" {{CORNER}}
{{MC_PARAM}}
.include "{{DUT_FILE}}"
.temp {{TEMP}}
.options reltol=1e-6 abstol=1e-15 vntol=1e-9
VDD vdd 0 {{VDD}}
VSS vss 0 0
IBIAS vdd ibias {{IBIAS}}
VCM vcm 0 {{VCM}}
VI vi vcm 0
R1 vi inp {{R_NET}}
R2 inp outn {{R_NET}}
R3 vi inn {{R_NET}}
R4 inn outp {{R_NET}}
XDUT vss ibias vdd vcmpin inp inn outp outn {{DUT}}
RVCM_DUT vcm vcmpin 1k
RLP outp vcm {{RL}}
CLP outp 0 {{CL}}
RLN outn vcm {{RL}}
CLN outn 0 {{CL}}
.control
set filetype=ascii
dc temp {{TEMP_START}} {{TEMP_STOP}} 1
write {{RAW}} v(outp) v(outn)
.endc
.end
