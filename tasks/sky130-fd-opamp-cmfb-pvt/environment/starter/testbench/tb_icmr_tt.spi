* Input common-mode range at tt / 1.8 V / 27 C.  The inputs sit at V(cms),
* stepped 0 .. 1.8 V in 25 mV steps; a DC-only differential servo (E sources
* through 1 GH, 1 GF to ground) keeps the amplifier open-loop for AC.  At each
* step it prints the input common mode, the differential gain at 0.1 Hz in dB,
* the output common-mode error and the differential output Vod.  The range is
* the contiguous span around VCM where the gain stays within 6 dB of its value
* at VCM, the output common mode within 50 mV of VCM and abs(Vod) <= 10 mV.
* Run with `ngspice -b testbench/tb_icmr_tt.spi`.
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "/app/circuit.spi"
.options reltol=1e-5 abstol=1e-15 vntol=1e-9
.temp 27
VDD vdd 0 1.8
VSS vss 0 0
IBIAS vdd ibias 10u
VCM vcm 0 0.9
VCMS cms 0 0.9
EP sp cms outn outp 0.5
EN sn cms outp outn 0.5
LP sp xp 1G
CP xp 0 1G
LN sn xn 1G
CN xn 0 1G
VAP inp xp DC 0 AC 0.5
VAN inn xn DC 0 AC 0.5 180
XDUT vss ibias vdd vcmpin inp inn outp outn fd_opamp
RVCM vcm vcmpin 1k
RLP outp vcm 1meg
CLP outp 0 2p
RLN outn vcm 1meg
CLN outn 0 2p
.control
set noaskquit
foreach v 0.000 0.025 0.050 0.075 0.100 0.125 0.150 0.175 0.200 0.225 0.250 0.275 0.300 0.325 0.350 0.375 0.400 0.425 0.450 0.475 0.500 0.525 0.550 0.575 0.600 0.625 0.650 0.675 0.700 0.725 0.750 0.775 0.800 0.825 0.850 0.875 0.900 0.925 0.950 0.975 1.000 1.025 1.050 1.075 1.100 1.125 1.150 1.175 1.200 1.225 1.250 1.275 1.300 1.325 1.350 1.375 1.400 1.425 1.450 1.475 1.500 1.525 1.550 1.575 1.600 1.625 1.650 1.675 1.700 1.725 1.750 1.775 1.800
  alter vcms dc = $v
  op
  let cm_err_v = 0.5 * (v(outp) + v(outn)) - 0.9
  set cmerr = "$&cm_err_v"
  let vod_v = v(outp) - v(outn)
  set vodv = "$&vod_v"
  ac lin 1 0.1 0.1
  let gain_db = db(v(outp) - v(outn))
  echo "icmr_step vin_cm=$v gain_db=$&gain_db cm_err_v=$cmerr vod_v=$vodv"
end
quit
.endc
.end
