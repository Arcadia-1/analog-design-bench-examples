* Closed-loop gain -1 network (100 kohm, feedback voutn->vinp, voutp->vinn) at
* tt / 1.8 V / 27 C, 2 pF || 1 Mohm on each output.  Prints the peaking of
* Vod/Vid above its 1 Hz value from 1 Hz to 10 GHz.
* Run with `ngspice -b testbench/tb_closedloop_tt.spi`.
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "/app/circuit.spi"
.options reltol=1e-5 abstol=1e-15 vntol=1e-9
.temp 27
VDD vdd 0 1.8
VSS vss 0 0
IBIAS vdd ibias 10u
VCM vcm 0 0.9
VIP vip vcm DC 0 AC 0.5
VIN vin vcm DC 0 AC 0.5 180
R1 vip inp 100k
R2 inp outn 100k
R3 vin inn 100k
R4 inn outp 100k
XDUT vss ibias vdd vcmpin inp inn outp outn fd_opamp
RVCM vcm vcmpin 1k
RLP outp vcm 1meg
CLP outp 0 2p
RLN outn vcm 1meg
CLN outn 0 2p
.control
set noaskquit
ac dec 100 1 10G
let h_db = db(v(outp) - v(outn))
meas ac h_1hz_db FIND h_db AT=1
meas ac h_max_db MAX h_db
let peaking_db = h_max_db - h_1hz_db
print peaking_db
quit
.endc
.end
