* Public development bench: tt, 27 C, 1.8 V, 45 uA load, 50 % duty. Grading uses the same
* circuit and metric definitions at other conditions inside the contract.
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "/app/circuit.spi"

.param supply=1.8 iload=45u duty=0.5
VSS AVSS 0 0
VDD AVDD_SRC 0 {supply}
VSENSE AVDD_SRC AVDD 0
VHIGH EN_SRC 0 {supply}
REN EN_SRC EN_R 50
VENSENSE EN_R EN 0
VCLK CLK_SRC 0 PULSE({supply} 0 0 1p 1p {duty*100n} 100n)
RCLK CLK_SRC CLK_R 50
VCLKSENSE CLK_R CLK 0
CLOAD VOUT 0 1n
ILOAD VOUT 0 {iload}
XDUT AVDD AVSS CLK EN VOUT charge_pump_unregulate
BPCLK p_clk 0 V=v(CLK)*i(VCLKSENSE)
BPEN p_en 0 V=v(EN)*i(VENSENSE)

.options reltol=0.001 vntol=1e-6 abstol=1e-12 gmin=1e-12
.temp 27
.tran 2n 200u 180u 1n
.measure tran vout_avg AVG v(VOUT) FROM=190u TO=200u
.measure tran vout_max MAX v(VOUT) FROM=190u TO=200u
.measure tran vout_min MIN v(VOUT) FROM=190u TO=200u
.measure tran i_avdd_avg AVG i(VSENSE) FROM=190u TO=200u
.measure tran p_clk_avg AVG v(p_clk) FROM=190u TO=200u
.measure tran p_en_avg AVG v(p_en) FROM=190u TO=200u
.end
