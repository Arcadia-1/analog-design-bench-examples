* CTLE stability after disturbances at one PVT point and code, with the inputs held at vocm through 50 ohm and no
* signal. Both 200 fF loads return to vdist, which steps by kick_cm volts with a 10 ns edge at 100 ns (a common-mode
* disturbance); at kick_t a differential current pulse of kick_dm amperes, 5 ns long, enters voutp and leaves voutn.
* The output common mode and the differential output are read from 3.1 us to 4.1 us. verify.py replaces the .lib
* section and the .param values before each run.
.lib "/opt/sky130/continuous/sky130.lib.spice" tt
.include "/app/circuit.spi"
.options filetype=ascii reltol=2e-4 abstol=1e-12 vntol=1e-6
.param supply=1.8
.param temperature=27
.temp {temperature}
.param code_g0=0
.param code_g1=0
.param code_p0=0
.param code_p1=0
.param kick_cm=0.1
.param kick_dm=1m
.param kick_t=1u
VSS vss 0 0
VDD vdd vss {supply}
IREF vdd iref 100u
VOCM vcmsrc vss {supply/2}
RVOCM vcmsrc vocm 10
VSP srcp vcmsrc DC 0
RSP srcp vinp 50
VSN srcn vcmsrc DC 0
RSN srcn vinn 50
VGB0 sgb0 vss {code_g0*supply}
RGB0 sgb0 gain_b0 1k
VGB1 sgb1 vss {code_g1*supply}
RGB1 sgb1 gain_b1 1k
VPB0 spb0 vss {code_p0*supply}
RPB0 spb0 peak_b0 1k
VPB1 spb1 vss {code_p1*supply}
RPB1 spb1 peak_b1 1k
XDUT vss vdd iref vocm vinp vinn gain_b0 gain_b1 peak_b0 peak_b1 voutp voutn ctle_28g
CLP voutp vdist 200f
CLN voutn vdist 200f
VDIST vdist vss DC 0 PWL(0 0 100n 0 110n {kick_cm})
IKP 0 voutp DC 0 PULSE(0 {kick_dm} {kick_t} 0.5n 0.5n 5n 1)
IKN voutn 0 DC 0 PULSE(0 {kick_dm} {kick_t} 0.5n 0.5n 5n 1)

.control
tran 0.5n 4.1u 0 0.5n
let cm_out = 0.5*(v(voutp)+v(voutn))
let dm_out = v(voutp)-v(voutn)
meas tran cm_kick_max_v max cm_out from=3.1u to=4.1u
meas tran cm_kick_min_v min cm_out from=3.1u to=4.1u
meas tran dm_kick_max_v max dm_out from=3.1u to=4.1u
meas tran dm_kick_min_v min dm_out from=3.1u to=4.1u
echo CTLE_ANALYSES_COMPLETE
.endc
.end
